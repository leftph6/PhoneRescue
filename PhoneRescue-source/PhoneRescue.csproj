<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PhoneRescue</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);toolchain/**;android/**;release/**;tests/**;driver-backup/**;.git/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
